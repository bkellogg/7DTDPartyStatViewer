<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
            Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{B2C3D4E5-F678-90AB-CDEF-123456789012}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>PartyStatViewer</RootNamespace>
        <AssemblyName>PartyStatViewer</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <LangVersion>9.0</LangVersion>
        <FileAlignment>512</FileAlignment>
        <GamePath>C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</GamePath>
        <ModName>PartyStatViewer</ModName>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="mscorlib">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\mscorlib.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="LogLibrary">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\LogLibrary.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GamePath)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Properties\AssemblyInfo.cs"/>
        <Compile Include="Harmony\Init.cs"/>
        <Compile Include="Harmony\Patches\ItemInfoWindowPatch.cs"/>
        <Compile Include="Harmony\Patches\ProgressionPatch.cs"/>
        <Compile Include="Scripts\NetPackages\NetPackageSkillDataRequest.cs"/>
        <Compile Include="Scripts\NetPackages\NetPackageSkillDataResponse.cs"/>
        <Compile Include="Scripts\BookTypeDetector.cs"/>
        <Compile Include="Scripts\SkillDataCache.cs"/>
        <Compile Include="Scripts\SkillDataManager.cs"/>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>

    <!-- Deploy mod to game folder after build -->
    <Target Name="DeployMod" AfterTargets="Build">
        <PropertyGroup>
            <ModFolder>$(GamePath)\Mods\$(ModName)</ModFolder>
        </PropertyGroup>
        <MakeDir Directories="$(ModFolder)" Condition="!Exists('$(ModFolder)')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)"/>
        <Copy SourceFiles="$(ProjectDir)ModInfo.xml" DestinationFolder="$(ModFolder)"/>
        <Message Text="Deployed $(ModName) to $(ModFolder)" Importance="high"/>
    </Target>

</Project>
